# Copy to backend/.env and fill in. backend/.env is gitignored — never commit real secrets.

# --- Database ---
# Matches docker/docker-compose.yml's postgres service (host "postgres" from inside the
# compose network). If running the backend outside Docker against the same compose
# postgres, use "localhost" instead.
DATABASE_URL=postgresql+asyncpg://postura:postura@postgres:5432/postura

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
COOKIE_SECURE=false
# "lax" for local dev (frontend/backend are same-site). If frontend and
# backend end up on different domains in production (e.g. a Vercel frontend
# calling a Render backend), set this to "none" AND COOKIE_SECURE=true —
# otherwise the browser silently drops the session cookie on every
# cross-site request and auth breaks with no obvious error.
COOKIE_SAMESITE=lax

# --- AI ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# --- Scanner / SSRF ---
# Comma-separated hostnames allowed to bypass the private-IP SSRF block. Local dev only —
# NEVER set this in production. Leave empty by default.
ALLOWED_SCAN_TARGETS=

# --- CORS ---
CORS_ORIGINS=http://localhost:3000

# --- Billing (Stripe) ---
# Test-mode values from the Stripe Dashboard (Developers -> API keys) and the
# "Pro" product's recurring monthly Price ID. STRIPE_WEBHOOK_SECRET comes
# from `stripe listen --forward-to http://localhost:8000/billing/webhook`
# for local dev (it prints a whsec_... value on start).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO=
FRONTEND_URL=http://localhost:3000
