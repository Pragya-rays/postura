# Optional. Copy to docker/.env to override — docker compose loads it
# automatically since it sits next to docker-compose.yml. Every value here
# already has a working default (see docker-compose.yml's comments); this
# file only matters if you want real Gemini explanations or a non-default
# JWT secret.

# Enables real AI-written explanations instead of the hardcoded fallback
# copy (ai-engine/ai_engine/fallback.py) — the app works fine without it.
GEMINI_API_KEY=
GEMINI_MODEL=

# Only worth setting if you're doing something other than throwaway local dev.
JWT_SECRET=

# Comma-separated hostnames allowed to bypass the SSRF private-IP block —
# NEVER set this against a real deployment. Empty by default.
ALLOWED_SCAN_TARGETS=

# Only needed if port 3000 is already taken on your host. CORS_ORIGINS in
# docker-compose.yml tracks this automatically, so this is the only value
# you need to change.
FRONTEND_PORT=

# Stripe test-mode values (Dashboard -> Developers -> API keys, and the
# "Pro" product's recurring monthly Price). STRIPE_WEBHOOK_SECRET comes from
# `stripe listen --forward-to http://localhost:8000/billing/webhook`.
# Without these, /billing routes return a clear "billing not configured"
# error — the rest of the app works fine.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO=
